# Cloudflare Pages custom headers
# Fix NS_ERROR_CORRUPTED_CONTENT by ensuring proper content-type and caching

# Student dashboard - always serve fresh HTML
/students/dashboard
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/students/dashboard.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Test Prep - NEVER cache the app shell during active development/testing
/students/test-prep-app/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/students/test-prep-app/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/students/test-prep-app/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Test Prep JS - force revalidation so revision query strings are honored immediately
/students/test-prep-app/*.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, must-revalidate, max-age=0

# JavaScript files
/Teachers/components/*.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/Teachers/tools/student_tracker/*.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/js/*.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=86400

# All JS files
/*.js
  Content-Type: application/javascript; charset=utf-8
  
# CSS files
/*.css
  Content-Type: text/css; charset=utf-8

# JSON files
/*.json
  Content-Type: application/json; charset=utf-8

# HTML files - allow caching but revalidate
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
