[{"id":"L07-001","level":7,"section":"vocabulary","type":"multiple-choice","prompt":"Choose the word closest in meaning to refuse.","answer":"decline","options":["decline","accept","explain","repeat"]},{"id":"L07-002","level":7,"section":"vocabulary","type":"multiple-choice","prompt":"Which word means 책임?","answer":"responsibility","options":["responsibility","possibility","personality","reality"]},{"id":"L07-003","level":7,"section":"grammar","type":"multiple-choice","prompt":"Tom said that he ___ his homework.","answer":"had forgotten","options":["had forgotten","has forgotten","forgets","was forgetting"]},{"id":"L07-004","level":7,"section":"grammar","type":"multiple-choice","prompt":"If the weather improves, we ___ outside.","answer":"will eat","options":["will eat","would eat","ate","have eaten"]},{"id":"L07-005","level":7,"section":"reading","type":"reading","passage":"Although the train was delayed, we reached the theatre before the performance began.","prompt":"What happened?","answer":"They arrived in time.","options":["They arrived in time.","They missed the performance.","The theatre was closed.","The train arrived early."]},{"id":"L07-006","level":7,"section":"reading","type":"reading","passage":"Minsu promised to help, but he never arrived, which left the others with twice as much work.","prompt":"What was the result of Minsu's absence?","answer":"The others had more work.","options":["The others had more work.","The work was cancelled.","Minsu finished everything.","The group left early."]}]