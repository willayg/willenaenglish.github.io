[{"id":"L05-001","level":5,"section":"vocabulary","type":"multiple-choice","prompt":"Choose the word closest in meaning to begin.","answer":"start","options":["start","finish","carry","forget"]},{"id":"L05-002","level":5,"section":"vocabulary","type":"multiple-choice","prompt":"Which word means 경험?","answer":"experience","options":["experience","experiment","example","exercise"]},{"id":"L05-003","level":5,"section":"grammar","type":"multiple-choice","prompt":"Yesterday, we ___ to the park.","answer":"went","options":["went","go","gone","going"]},{"id":"L05-004","level":5,"section":"grammar","type":"multiple-choice","prompt":"You ___ see a doctor if the pain continues.","answer":"should","options":["should","would","might to","are"]},{"id":"L05-005","level":5,"section":"reading","type":"reading","passage":"Ella missed the bus, so she called her father and arrived at school by car.","prompt":"How did Ella get to school?","answer":"Her father drove her.","options":["Her father drove her.","She walked.","She took another bus.","She rode a bicycle."]},{"id":"L05-006","level":5,"section":"reading","type":"reading","passage":"There were five cakes in the shop. Three were sold before lunch.","prompt":"How many cakes remained?","answer":"two","options":["two","three","five","eight"]}]