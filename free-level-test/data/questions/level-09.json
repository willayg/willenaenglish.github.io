[{"id":"L09-001","level":9,"section":"grammar","skill":"Grammar","type":"multiple-choice","prompt":"The findings are compelling, ___ they do not establish causation.","answer":"although","options":["although","because","unless","therefore"]},{"id":"L09-002","level":9,"section":"vocabulary","skill":"Vocabulary","type":"multiple-choice","prompt":"Which word means 불가피한?","answer":"inevitable","options":["inevitable","optional","invisible","temporary"]},{"id":"L09-003","level":9,"section":"reading","skill":"Reading","type":"multiple-choice","prompt":"The argument relies on a correlation and then treats it as proof of cause. What is the weakness?","answer":"It confuses correlation with causation.","options":["It confuses correlation with causation.","It lacks any data.","It is too short.","It uses no examples."]},{"id":"L09-004","level":9,"section":"grammar","skill":"Grammar","type":"multiple-choice","prompt":"Were the situation to change, we ___ the decision.","answer":"would reconsider","options":["would reconsider","reconsidered","will reconsidered","had reconsider"]}]